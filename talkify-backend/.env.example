# Server port (1-65535).
PORT=3001
# Allowed browser origin(s) for REST + Socket.IO (comma-separated for several).
# Required in production; defaults to the Vite dev server otherwise.
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Required. HMAC key for signing session tokens. In production it must be a random
# value of at least 32 characters (e.g. `openssl rand -hex 32`); placeholders are rejected.
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
# Reverse-proxy hops in front of the app (nginx, Caddy, a load balancer). Controls
# which X-Forwarded-For entries Express trusts for req.ip (rate limiting, login logs).
# Leave unset when clients connect directly. Use "1" for a single proxy; "true" is rejected.
# TRUST_PROXY=1
